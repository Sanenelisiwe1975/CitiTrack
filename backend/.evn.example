# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
ENVIRONMENT=development

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/cititrack
DATABASE_POOL_SIZE=20

# AI Models
OPENAI_API_KEY=your_openai_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here
AI_MODEL=gpt-4

# Blockchain
ETHEREUM_RPC_URL=https://polygon-mumbai.g.alchemy.com/v2/YOUR-API-KEY
CONTRACT_ADDRESS=0x...
PRIVATE_KEY=your_private_key_here

# SMS Service (Africa's Talking)
AT_USERNAME=sandbox
AT_API_KEY=your_api_key_here
AT_SENDER_ID=CitiTrack

# Cloud Storage
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
S3_BUCKET_NAME=cititrack-uploads
S3_REGION=af-south-1

# Security
SECRET_KEY=your_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS
CORS_ORIGINS=http://localhost:3000,https://cititrack.netlify.app